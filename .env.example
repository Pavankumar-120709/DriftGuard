# Application Configuration
APP_NAME=DriftGuard
APP_ENV=development
API_PORT=8000
API_HOST=0.0.0.0
FRONTEND_PORT=3000

# Database Configuration
# In production / docker: postgresql://driftguard:driftguard@postgres:5432/driftguard_db
# For local fallback: sqlite:///./driftguard.db
DATABASE_URL=sqlite:///./driftguard.db

# MLflow Configuration
MLFLOW_TRACKING_URI=sqlite:///./mlruns.db
MLFLOW_ARTIFACT_ROOT=./mlartifacts
MLFLOW_EXPERIMENT_NAME=customer-churn-prediction

# Evidently Monitoring Configuration
DRIFT_REPORT_DIR=./reports/drift
DRIFT_SHARE_THRESHOLD=0.3
P_VALUE_THRESHOLD=0.05
REFERENCE_DATA_PATH=./data/processed/reference_data.csv

# Retraining Configuration
RETRAINING_DRIFT_THRESHOLD=0.35
RETRAINING_PERFORMANCE_DROP_THRESHOLD=0.05
MIN_RETRAINING_SAMPLES=100
AUTO_RETRAIN_ENABLED=true
